{
  "name": "donkey-gateway",
  "version": "1.0.6",
  "description": "API Gateway based on static configuration files",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "prepublishOnly": "npm run lint && npm test",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A .",
    "postversion": "git push && git push --tags",
    "prepare": "npm run build",
    "format": "prettier --write \"*.ts\" \"middlewares/*.ts\" \"tests/*.ts\"",
    "lint": "eslint . && tsc -p tsconfig.test.json",
    "build": "tsc",
    "serve": "npm run build && node build/donkey.js --run",
    "backend": "node tests/backend.js",
    "test": "jest --coverage",
    "format:check": "prettier --check \"*.ts\" \"middlewares/*.ts\" \"tests/*.ts\"",
    "serve-dev": "tsc --watch & node --watch build/donkey.js --run"
  },
  "files": [
    "build/**/*"
  ],
  "author": "batiste.bieler@gmail.com",
  "license": "MIT",
  "dependencies": {
    "commander": "~7.2.0",
    "jsonwebtoken": "^9.0.3",
    "rate-limit-redis": "~2.1.0",
    "redis": "^3.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "~22.20.5",
    "@types/rate-limit-redis": "~1.7.4",
    "@types/redis": "^2.8.32",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "got": "~11.8.6",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "donkey": "build/donkey.js"
  }
}
